rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /attendance/{docId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.memberId == request.auth.uid);
      allow create, update: if request.auth != null && isAdmin();
    }
    match /profiles/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /memberships/{id} {
      allow read, write: if request.auth != null;
    }
    match /transactions/{id} {
      allow read, write: if request.auth != null;
    }
    match /plans/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
  }
}
